<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Randevularım</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>body{background:#0b0c10;color:#f1f5f9;}</style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark"><div class="container"><a class="navbar-brand" href="/">Nova Cast</a></div></nav>
    <div class="container my-5">
        <h2>📅 Randevularım</h2>
        <table class="table table-dark table-striped mt-3">
            <thead><tr><th>Tarih</th><th>Saat</th><th>Durum</th><th>Notlar</th></tr></thead>
            <tbody>
                {% for r in randevular %}
                <tr>
                    <td>{{ r.tarih }}</td>
                    <td>{{ r.saat }}</td>
                    <td><span class="badge bg-{% if r.durum == 'onaylandi' %}success{% elif r.durum == 'iptal' %}danger{% elif r.durum == 'tamamlandi' %}secondary{% else %}warning{% endif %}">{{ r.durum }}</span></td>
                    <td>{{ r.notlar or '-' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <a href="/" class="btn btn-secondary">Ana Sayfa</a>
    </div>
</body>
</html>